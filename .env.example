# ─────────────────────────────────────────────
# PostgreSQL (docker-compose, core-api, chain-service)
# ─────────────────────────────────────────────
POSTGRES_USER=user
POSTGRES_PASSWORD=change_me

# ─────────────────────────────────────────────
# RPC endpoints (contracts/foundry.toml: --rpc-url anvil | sepolia)
# ─────────────────────────────────────────────
RPC_URL_ANVIL=http://localhost:8545
RPC_URL_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=

# ─────────────────────────────────────────────
# Contract deployment: Anvil (contracts/script/DeployEURDemo.s.sol)
# Addresses are the default Anvil accounts #1, #2 and #3.
# PRIVATE_KEY_ANVIL: private key of Anvil account #0 (printed by `anvil` on startup);
# the deployer becomes DEFAULT_ADMIN_ROLE. Never reuse Anvil keys on a real network.
# ─────────────────────────────────────────────
PRIVATE_KEY_ANVIL=
MINTER_ADDRESS_ANVIL=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
PAUSER_ADDRESS_ANVIL=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
BLACKLISTER_ADDRESS_ANVIL=0x90F79bf6EB2c4f870365E785982E1f101E93b906
# Address printed by the deploy script; see docs/deployments.md
EURD_CONTRACT_ADDRESS_ANVIL=0x5FbDB2315678afecb367f032d93F642f64180aa3

# ─────────────────────────────────────────────
# Contract deployment: Sepolia
# MINTER = chain-service account; PAUSER and BLACKLISTER = technical admin account(s)
# ─────────────────────────────────────────────
PRIVATE_KEY_SEPOLIA=
MINTER_ADDRESS_SEPOLIA=
PAUSER_ADDRESS_SEPOLIA=
BLACKLISTER_ADDRESS_SEPOLIA=
EURD_CONTRACT_ADDRESS_SEPOLIA=
